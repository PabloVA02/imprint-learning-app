{
  "name": "imprint-onboarding-prototype",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "tsc --noEmit && vite build && mkdir -p dist/server && cp worker/static-worker.js dist/server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src/onboarding.test.tsx"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "27.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "type": "module"
}
